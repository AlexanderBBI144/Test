# Telegram API credentials (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Telegram session — either a session file name or a session string.
# If using a file, place <TG_SESSION>.session next to this .env.
# If using StringSession, paste the exported string here.
TG_SESSION=tg_test_session

# Username or numeric ID of the bot under test (without @).
TG_BOT_USERNAME=

# --- Optional tuning ---
# Default timeout (seconds) when waiting for bot responses.
TG_TIMEOUT=10
# Max automatic retries on FloodWaitError.
TG_RATE_LIMIT_RETRIES=3
