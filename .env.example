# Telegram API credentials (https://my.telegram.org)
TG_API_ID=12345
TG_API_HASH=0123456789abcdef0123456789abcdef

# Session name (file will be <SESSION_NAME>.session)
TG_SESSION=test_user

# Bot username to test against (without @)
TG_BOT_USERNAME=my_bot

# Timeouts (seconds)
TG_DEFAULT_TIMEOUT=10
TG_RATE_LIMIT_PAUSE=5
